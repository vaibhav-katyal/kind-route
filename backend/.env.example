# KindRoute Backend Environment Variables Example
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/kindroute?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/kindroute
MONGODB_URI=mongodb://127.0.0.1:27017/kindroute

# JWT Authentication Secret Key (Any long secure random string)
JWT_SECRET=kindroute_secret_jwt_key_2026_super_secure

# Allowed Client Origin (Frontend URL)
CLIENT_URL=http://localhost:5173
